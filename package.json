{
  "name": "aozora-history",
  "version": "0.11.2",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsgo --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "test:logic": "vitest run --project=logic",
    "test:dom": "vitest run --project=dom",
    "test:watch": "vitest",
    "verify": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run test",
    "dev:assets": "mkdir -p .preview && cp src/dashboard/dashboard.html src/icon.svg .preview/",
    "dev:css": "tailwindcss -i src/dashboard/styles.css -o .preview/dashboard.css --watch=always",
    "dev:js": "esbuild src/dev/main.ts --bundle --outfile=.preview/dashboard.js --format=iife --define:BUILD_STAMP=\"'dev'\" --watch=forever --servedir=.preview",
    "dev": "pnpm run dev:assets && { trap 'kill 0' EXIT; pnpm run dev:css & pnpm run dev:js; }",
    "build": "node build.js",
    "package:local": "pnpm run build && rm -f aozora-history-local.xpi && cd dist && zip -r ../aozora-history-local.xpi .",
    "package:firefox": "pnpm run build && rm -f aozora-history-v${VERSION:?}.xpi && cd dist && zip -r ../aozora-history-v${VERSION:?}.xpi .",
    "package:source": "git archive -o aozora-history-source-v${VERSION:?}.zip HEAD"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@tailwindcss/vite": "4.3.2",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "esbuild": "^0.28.1",
    "knip": "^6.29.0",
    "playwright": "1.60.0",
    "tailwindcss": "^4.3.2",
    "vitest": "^4.1.10"
  }
}
